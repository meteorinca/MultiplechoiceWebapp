rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - allow read/write for user management
    // Note: This app uses custom authentication, so we can't use request.auth
    // For production, consider adding additional security measures
    match /users/{userId} {
      allow read, write: if true;

      // Exams stored as subcollections under each user
      match /exams/{examId} {
        allow read, write: if true;
      }

      // Whiteboards stored as subcollections under each user
      match /whiteboards/{boardId} {
        // Allow read operations (list and get) - path already ensures user isolation
        // For list queries, Firestore can't check resource.data before allowing the query
        // The path structure (users/{userId}/whiteboards) already provides isolation
        allow read: if true;
        // Allow create if userId in document matches path userId
        allow create: if request.resource.data.userId == userId;
        // Allow update if userId matches and doesn't change
        allow update: if resource.data.userId == userId && request.resource.data.userId == userId;
        // Allow delete if userId matches
        allow delete: if resource.data.userId == userId;
      }
    }
    
    // Exams collection - allow read/write for exam management
    match /exams/{examId} {
      allow read, write: if true;
    }
    
    // Sessions collection - allow read/write for session logging
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
    
    // Attempts collection - allow read/write for attempt logging
    match /attempts/{attemptId} {
      allow read, write: if true;
    }
  }
}

